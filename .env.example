# Copy to .env for local development. Never put real credentials in this file.
APP_ENV=development
APP_NAME=Cyber Intelligence Platform API
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=INFO

# Authentication settings
AUTH_SECRET_KEY=change_me_in_development_only_32_chars_plus
AUTH_ALGORITHM=HS256
AUTH_ISSUER=cip-local
AUTH_AUDIENCE=cip
AUTH_TOKEN_TTL_MINUTES=60

# Optional OIDC resource-server settings. Required outside APP_ENV=development.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# PostgreSQL local development settings
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cip_dev
POSTGRES_USER=cip_user
POSTGRES_PASSWORD=change_me
